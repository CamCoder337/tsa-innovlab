# ================================
# TSA Logistics - Production Environment
# ================================
# SECURITY WARNING: Update all passwords and secrets before production deployment

# =====================================
# Database Configuration
# =====================================
POSTGRES_DB=tsa_contest_prod
POSTGRES_USER=tsa_prod_user
POSTGRES_PASSWORD=CHANGE_ME_VERY_STRONG_DB_PASSWORD_2024!

# =====================================
# Redis Configuration
# =====================================
REDIS_PASSWORD=CHANGE_ME_VERY_STRONG_REDIS_PASSWORD_2024!

# =====================================
# Application Security
# =====================================
# Generate with: openssl rand -hex 16
APP_KEY=CHANGE_ME_GENERATE_32_CHARACTER_SECRET

# =====================================
# Email Configuration
# =====================================
SMTP_HOST=smtp.your-domain.com
SMTP_PORT=587
SMTP_USERNAME=noreply@your-domain.com
SMTP_PASSWORD=your-secure-email-password
MAIL_FROM=noreply@your-domain.com

# =====================================
# URLs and Domains
# =====================================
FRONTEND_URL=https://your-domain.com
API_BASE_URL=https://api.your-domain.com

# =====================================
# Port Configuration
# =====================================
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_PORT=5432
REDIS_PORT=6379
MONOLITH_PORT=3333
AI_PORT=8000