# TSA InnovLab - Environment Configuration

# Database Configuration
POSTGRES_DB=tsa_contest
POSTGRES_USER=tsa_user
POSTGRES_PASSWORD=tsa_password
DB_HOST=postgres
DB_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=tsa_redis_password

# AdonisJS Configuration
NODE_ENV=production
APP_KEY=your-32-character-secret-key-here
HOST=0.0.0.0
PORT=3333
SESSION_DRIVER=redis

# FastAPI Configuration
ENVIRONMENT=production
PYTHONUNBUFFERED=1
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# URLs
DATABASE_URL=postgresql://tsa_user:tsa_password@postgres:5432/tsa_contest
REDIS_URL=redis://:tsa_redis_password@redis:6379/0

# External Services (if any)
# SENTRY_DSN=your_sentry_dsn_here
# MONITORING_ENDPOINT=your_monitoring_endpoint

# LLM Configuration (Groq)
GROQ_API_KEY=gsk_your_primary_groq_api_key
GROQ_API_KEY_FALLBACK=gsk_your_fallback_groq_api_key
LLM_MODEL=llama-3.3-70b-versatile
LLM_MODEL_FALLBACK=llama-3.1-8b-instant
LLM_ENABLED=true