# ================================
# TSA Logistics - Environment Variables Template
# ================================
# IMPORTANT: Ne JAMAIS commiter le fichier .env avec des vraies valeurs !
# Copier ce fichier en .env et remplir avec vos valeurs

# =====================================
# Application
# =====================================
NODE_ENV=development
APP_KEY=CHANGE_ME_32_CHARACTERS_SECRET
APP_NAME="TSA Logistics"
APP_VERSION=1.0.0
LOG_LEVEL=info

# =====================================
# Server
# =====================================
HOST=0.0.0.0
PORT=3333
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:3333

# =====================================
# Database (PostgreSQL)
# =====================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tsa_contest
POSTGRES_USER=tsa_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# =====================================
# Redis
# =====================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# =====================================
# FastAPI AI Service
# =====================================
FASTAPI_BASE_URL=http://localhost:8000

# =====================================
# Email (SMTP)
# =====================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=CHANGE_ME_APP_PASSWORD
MAIL_FROM=noreply@tsa-logistics.com

# =====================================
# Resend API (Alternative Email)
# =====================================
RESEND_API_KEY=CHANGE_ME_RESEND_KEY
MAIL_DOMAIN=tsa-logistics.com

# =====================================
# Admin User
# =====================================
ADMIN_EMAIL=admin@tsa-logistics.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SUPPORT_EMAIL=support@tsa-logistics.com

# =====================================
# Security
# =====================================
SECURE_COOKIES=false
TRUST_PROXY=false

# =====================================
# Google Cloud (Vision API)
# =====================================
GOOGLE_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/google-credentials.json

# =====================================
# Monitoring (Optional)
# =====================================
SENTRY_DSN=
PROMETHEUS_ENABLED=false

# =====================================
# Rate Limiting
# =====================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
