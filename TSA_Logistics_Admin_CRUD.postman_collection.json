	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Vérification automatique du token avant chaque requête",
					"if (pm.request.headers.get('Authorization')) {",
					"    console.log('🔐 Using token:', pm.environment.get('token') ? 'Token present' : 'No token found');",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Logs automatiques pour toutes les réponses",
					"console.log('📡 Response Status:', pm.response.code, pm.response.status);",
					"",
					"// Vérification de la structure de réponse TSA Logistics",
					"if (pm.response.code >= 200 && pm.response.code < 300) {",
					"    const response = pm.response.json();",
					"    if (response.success !== undefined) {",
					"        pm.test('✅ Response has success field', function () {",
					"            pm.expect(response).to.have.property('success');",
					"        });",
					"        ",
					"        pm.test('✅ Success is true for 2xx responses', function () {",
					"            pm.expect(response.success).to.be.true;",
					"        });",
					"        ",
					"        pm.test('✅ Response has message', function () {",
					"            pm.expect(response).to.have.property('message');",
					"        });",
					"    }",
					"} else if (pm.response.code >= 400) {",
					"    const response = pm.response.json();",
					"    pm.test('❌ Error response has proper structure', function () {",
					"        pm.expect(response).to.have.property('success').that.is.false;",
					"        pm.expect(response).to.have.property('message');",
					"    });",
					"}"
				]
			}
		}
