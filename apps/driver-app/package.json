{
  "name": "driver-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/smart-start.js",
    "start:basic": "expo start",
    "start:tunnel": "expo start --tunnel --clear",
    "dev": "npm run update-ip && expo start --clear",
    "update-ip": "node scripts/detect-local-ip.js",
    "diagnose": "node scripts/diagnose-connection.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "npm run typecheck && npm run lint && npm run format:check",
    "env:dev": "node scripts/switch-env.js development",
    "env:prod": "node scripts/switch-env.js production",
    "check": "node scripts/pre-deploy-check.js",
    "deploy:android": "node scripts/deploy.js android eas",
    "deploy:ios": "node scripts/deploy.js ios eas",
    "deploy:both": "node scripts/deploy.js both eas",
    "deploy:android:local": "node scripts/deploy.js android local",
    "build:eas": "npx eas build --platform android --profile production",
    "update:eas": "npx eas update --branch production",
    "publish": "npx expo publish"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.8.5",
    "@react-navigation/native": "^7.1.20",
    "@react-navigation/stack": "^7.6.4",
    "@types/react-native-modal": "^3.1.1",
    "axios": "^1.13.2",
    "babel-preset-expo": "~54.0.0",
    "expo": "~54.0.25",
    "expo-camera": "^17.0.9",
    "expo-constants": "^18.0.10",
    "expo-dev-client": "~6.0.18",
    "expo-file-system": "~19.0.19",
    "expo-image-picker": "~17.0.8",
    "expo-location": "~19.0.7",
    "expo-status-bar": "~3.0.8",
    "expo-updates": "~29.0.13",
    "i18next": "^24.2.0",
    "i18next-resources-to-backend": "^1.2.1",
    "react": "19.1.0",
    "react-i18next": "^15.2.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-signature-canvas": "^5.0.1",
    "react-native-webview": "^13.15.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^9.33.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
