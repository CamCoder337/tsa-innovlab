# TSA Driver App - Local Development Environment
# Pour utiliser cet environnement : cp .env.development .env

EXPO_PUBLIC_ENV=development

# API Configuration - Serveur local
# Remplacer par votre IP locale si vous testez sur un appareil physique
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.55:3333
EXPO_PUBLIC_API_TIMEOUT=30000

# Google Maps
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyD5g9ETxr6QFGf06HzSp48f6E-5HT5K0zo
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Location Tracking
EXPO_PUBLIC_LOCATION_UPDATE_INTERVAL=5000
EXPO_PUBLIC_LOCATION_DISTANCE_FILTER=10
EXPO_PUBLIC_LOCATION_ACCURACY=bestForNavigation

# Debugging - Activé en développement
EXPO_PUBLIC_DEBUG_MODE=true
EXPO_PUBLIC_DEBUG_TRACKING=true
EXPO_PUBLIC_DEBUG_API=true

# Security
EXPO_PUBLIC_ENABLE_SSL=false

# App Info
EXPO_PUBLIC_APP_NAME=TSA Driver
EXPO_PUBLIC_APP_VERSION=1.0.0

# Feature Flags
EXPO_PUBLIC_ENABLE_SIMULATION=true
EXPO_PUBLIC_ENABLE_ISSUE_REPORTING=true
EXPO_PUBLIC_ENABLE_QR_VALIDATION=true
