# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  TSA Driver App - Environment Configuration                                ║
# ╚════════════════════════════════════════════════════════════════════════════╝
#
# Ce fichier contient toutes les variables d'environnement nécessaires pour
# l'application driver-app. Copier ce fichier en .env et remplacer les valeurs.
#
# IMPORTANT: Les variables doivent commencer par EXPO_PUBLIC_ pour être
# accessibles dans l'application React Native/Expo.

# ═══════════════════════════════════════════════════════════════════════════
# 🌍 ENVIRONMENT
# ═══════════════════════════════════════════════════════════════════════════
# Environnement actuel : development | staging | production
EXPO_PUBLIC_ENV=development

# ═══════════════════════════════════════════════════════════════════════════
# 🔌 API CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# URL de base de l'API backend (AdonisJS Monolith)
#
# 🎯 RECOMMANDÉ : Utilisez la détection automatique d'IP
#    Exécutez : npm run update-ip
#    Ou lancez : npm run dev (détecte l'IP + démarre Expo)
#
# Pour développement local :
# - Simulateur iOS        : http://localhost:3333
# - Émulateur Android     : http://10.0.2.2:3333
# - Appareil physique     : http://<VOTRE_IP_LOCAL>:3333
#   (exemple: http://192.168.1.100:3333)
#
# Pour trouver votre IP locale manuellement :
# - Windows : ipconfig (cherchez IPv4)
# - Mac/Linux : ifconfig ou ip addr
#
# Pour staging/production : utiliser l'URL du serveur déployé
EXPO_PUBLIC_API_BASE_URL=http://localhost:3333

# Timeout des requêtes API (en millisecondes)
EXPO_PUBLIC_API_TIMEOUT=30000

# ═══════════════════════════════════════════════════════════════════════════
# 🗺️  GOOGLE MAPS CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Clé API Google Maps (obtenue depuis Google Cloud Console)
# https://console.cloud.google.com/google/maps-apis/credentials
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ID de la carte Google Maps personnalisée (optionnel)
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ═══════════════════════════════════════════════════════════════════════════
# 📍 LOCATION TRACKING CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Intervalle de mise à jour de la position (en millisecondes)
# Défaut: 5000 (5 secondes)
EXPO_PUBLIC_LOCATION_UPDATE_INTERVAL=5000

# Distance minimale pour déclencher une mise à jour (en mètres)
# Défaut: 10 (10 mètres)
EXPO_PUBLIC_LOCATION_DISTANCE_FILTER=10

# Précision du GPS
# Options: lowest | low | balanced | high | highest | bestForNavigation
# Défaut: bestForNavigation
EXPO_PUBLIC_LOCATION_ACCURACY=bestForNavigation

# ═══════════════════════════════════════════════════════════════════════════
# 🐛 DEBUGGING & LOGGING
# ═══════════════════════════════════════════════════════════════════════════

# Activer les logs détaillés pour le débogage
# true | false
EXPO_PUBLIC_DEBUG_MODE=true

# Activer les logs de tracking GPS
EXPO_PUBLIC_DEBUG_TRACKING=true

# Activer les logs des requêtes API
EXPO_PUBLIC_DEBUG_API=true

# ═══════════════════════════════════════════════════════════════════════════
# 🔐 SECURITY
# ═══════════════════════════════════════════════════════════════════════════

# Activer le mode SSL/TLS strict (recommandé en production)
# true | false
EXPO_PUBLIC_ENABLE_SSL=false

# ═══════════════════════════════════════════════════════════════════════════
# 📱 APP CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Nom de l'application (affiché dans l'UI)
EXPO_PUBLIC_APP_NAME=TSA Driver

# Version de l'application
EXPO_PUBLIC_APP_VERSION=1.0.0

# ═══════════════════════════════════════════════════════════════════════════
# 🧪 FEATURE FLAGS
# ═══════════════════════════════════════════════════════════════════════════

# Activer le mode simulation (pour tester sans vraie mission)
EXPO_PUBLIC_ENABLE_SIMULATION=false

# Activer la fonctionnalité de rapport d'incidents
EXPO_PUBLIC_ENABLE_ISSUE_REPORTING=true

# Activer la validation par QR Code
EXPO_PUBLIC_ENABLE_QR_VALIDATION=true

# ═══════════════════════════════════════════════════════════════════════════
# 📝 NOTES
# ═══════════════════════════════════════════════════════════════════════════
#
# 1. Après modification de ce fichier, redémarrer l'application :
#    npx expo start --clear
#
# 2. Pour les appareils physiques, assurez-vous d'être sur le même réseau
#    que votre machine de développement.
#
# 3. Les variables sont injectées au moment du build. Pour les changements
#    en production, utiliser EAS Build avec des secrets configurés.
#
# 4. Ne jamais committer le fichier .env dans Git (il est dans .gitignore)
#
