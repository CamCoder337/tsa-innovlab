EXPO_PUBLIC_APP_VERSION=1.0.0

# Feature Flags
EXPO_PUBLIC_ENABLE_SIMULATION=false
EXPO_PUBLIC_ENABLE_ISSUE_REPORTING=true
EXPO_PUBLIC_ENABLE_QR_VALIDATION=true
