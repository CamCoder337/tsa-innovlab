# TSA Driver App - Production Environment
# Pour utiliser cet environnement : cp .env.production .env

EXPO_PUBLIC_ENV=production

# API Configuration - Serveur en ligne
EXPO_PUBLIC_API_BASE_URL=http://51.91.77.0:30000
EXPO_PUBLIC_API_TIMEOUT=30000

# Google Maps
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyD5g9ETxr6QFGf06HzSp48f6E-5HT5K0zo
