# Location Tracking
EXPO_PUBLIC_LOCATION_UPDATE_INTERVAL=5000
EXPO_PUBLIC_LOCATION_DISTANCE_FILTER=10
EXPO_PUBLIC_LOCATION_ACCURACY=bestForNavigation

# Debugging - Désactivé en production
