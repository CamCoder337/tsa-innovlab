# ========================================
# TSA AI - LOCAL DOCKER ENVIRONMENT
# ========================================
# Configuration pour développement local avec Docker
# Le service FastAPI tourne dans Docker et se connecte à PostgreSQL et Redis locaux
# Copier ce fichier en .env pour l'utiliser: cp .env.docker .env

# ========================================
# APPLICATION
# ========================================
APP_NAME="TSA Contest AI API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# ========================================
# BASE DE DONNÉES POSTGRESQL (LOCAL)
# ========================================
# Connexion à PostgreSQL qui tourne sur la machine hôte
# host.docker.internal permet au conteneur d'accéder aux services locaux
# IMPORTANT: Adapter ces valeurs selon votre configuration PostgreSQL locale
DATABASE_URL=postgresql://postgres:1234@host.docker.internal:5432/tsa_logistics

# ========================================
# REDIS CACHE (LOCAL)
# ========================================
# Connexion à Redis qui tourne sur la machine hôte
# Si Redis n'a pas de mot de passe, utiliser redis://host.docker.internal:6379
REDIS_URL=redis://host.docker.internal:6379
CACHE_TTL_SECONDS=300

# ========================================
# CORS ORIGINS
# ========================================
# Autoriser les requêtes depuis ces origines
ALLOWED_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://localhost:3333", "http://localhost:80"]'

# ========================================
# ML MODELS
# ========================================
MODELS_PATH="ml_models"
PREDICTION_BATCH_SIZE=100
MODEL_RELOAD_INTERVAL=3600

# ========================================
# MONITORING (Optionnel)
# ========================================
SENTRY_DSN=""

# ========================================
# INTERNAL SERVICE COMMUNICATION
# ========================================
INTERNAL_SERVICE_SECRET="internal-secret-key-change-in-production"
