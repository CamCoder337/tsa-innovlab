# FastAPI AI Service Environment Variables
# Copy this file to .env and update with your values

# ========================================
# APPLICATION
# ========================================
APP_NAME="TSA Contest AI API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# ========================================
# DATABASE (shared with tsa-monolith)
# ========================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/tsa_logistics"

# ========================================
# REDIS (Optional for caching ML predictions)
# ========================================
REDIS_URL="redis://localhost:6379"
CACHE_TTL_SECONDS=300

# ========================================
# CORS ORIGINS
# ========================================
ALLOWED_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://localhost:3333"]'

# ========================================
# ML MODELS
# ========================================
MODELS_PATH="ml_models"
PREDICTION_BATCH_SIZE=100
MODEL_RELOAD_INTERVAL=3600

# ========================================
# MONITORING (Sentry)
# ========================================
SENTRY_DSN=""

# ========================================
# INTERNAL SERVICE COMMUNICATION
# ========================================
INTERNAL_SERVICE_SECRET="internal-secret-key-change-in-production"

# ========================================
# LLM CONFIGURATION (Groq)
# ========================================
GROQ_API_KEY="your_groq_api_key_here"
LLM_MODEL="llama-3.3-70b-versatile"
LLM_ENABLED=true

# ========================================
# MONOLITH API
# ========================================
MONOLITH_API_URL="http://tsa-monolith:3333/api"