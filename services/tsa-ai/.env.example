# FastAPI AI Service Environment Variables
# Copy this file to .env and update with your values

# ========================================
# APPLICATION
# ========================================
APP_NAME="TSA Contest AI API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# ========================================
# DATABASE (shared with tsa-monolith)
# ========================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/tsa_logistics"

# ========================================
# REDIS (Optional for caching ML predictions)
# ========================================
REDIS_URL="redis://localhost:6379"
CACHE_TTL_SECONDS=300

# ========================================
# CORS ORIGINS
# ========================================
ALLOWED_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://localhost:3333"]'

# ========================================
# ML MODELS
# ========================================
MODELS_PATH="ml_models"
PREDICTION_BATCH_SIZE=100
MODEL_RELOAD_INTERVAL=3600

# ========================================
# MONITORING (Sentry)
# ========================================
SENTRY_DSN=""

# ========================================
# INTERNAL SERVICE COMMUNICATION
# ========================================
INTERNAL_SERVICE_SECRET="internal-secret-key-change-in-production"

# ========================================
# PRODUCT RECOMMENDATION SYSTEM
# ========================================
# Minimum purchases required for collaborative filtering (default: 3)
REC_MIN_PURCHASES_COLLABORATIVE=3

# Minimum purchases required for content-based recommendations (default: 1)
REC_MIN_PURCHASES_CONTENT=1

# Maximum number of similar users to consider (default: 20)
REC_SIMILAR_USERS_LIMIT=20

# Minimum common products to consider users as similar (default: 2)
REC_MIN_COMMON_PRODUCTS=2

# Price range multiplier for content-based recommendations (default: 0.5 = ±50%)
# Example: 0.5 means recommend products from 50% to 200% of average price
REC_PRICE_RANGE_MULTIPLIER=0.5

# Price range for similar product recommendations (default: 0.3 = ±30%)
# Example: 0.3 means recommend products from 70% to 130% of product price
REC_SIMILAR_PRICE_RANGE=0.3

# Default time window in days for popularity-based recommendations (default: 30)
REC_DEFAULT_TIME_WINDOW_DAYS=30