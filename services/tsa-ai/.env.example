# FastAPI AI Service Environment Variables

# Application
APP_NAME="TSA Contest AI API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# Database (shared with Adonis)
DATABASE_URL="postgresql://tsa_user:tsa_password@postgres:5432/tsa_contest"

# CORS Origins
ALLOWED_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://localhost:80"]'

# ML Models
MODELS_PATH="ml_models"
PREDICTION_BATCH_SIZE=100
MODEL_RELOAD_INTERVAL=3600

# Monitoring (Sentry)
SENTRY_DSN=""

# Redis (Optional for caching ML predictions)
REDIS_URL=""
CACHE_TTL_SECONDS=300

# Internal service communication
INTERNAL_SERVICE_SECRET="internal-secret-key-change-in-production"