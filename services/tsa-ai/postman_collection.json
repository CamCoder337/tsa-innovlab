    {
      "name": "7. AdonisJS Integration",
      "item": [
        {
          "name": "Login - Get Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.token && jsonData.token.accessToken) {",
                  "        pm.environment.set('jwt_token', jsonData.token.accessToken);",
                  "        console.log('JWT token saved');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{adonis_url}}/auth/login",
              "host": ["{{adonis_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login pour obtenir un JWT token"
          },
          "response": []
        },
        {
          "name": "Recommendations via AdonisJS",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{adonis_url}}/shop/product-recommendations?limit=10&context=homepage",
              "host": ["{{adonis_url}}"],
              "path": ["shop", "product-recommendations"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "context",
                  "value": "homepage"
                }
              ]
            },
            "description": "Recommandations personnalisées via l'API AdonisJS (nécessite authentification)"
          },
          "response": []
        },
        {
          "name": "Similar Products via AdonisJS",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{adonis_url}}/shop/product-recommendations/similar/{{test_product_id}}?limit=5",
              "host": ["{{adonis_url}}"],
              "path": ["shop", "product-recommendations", "similar", "{{test_product_id}}"],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Produits similaires via AdonisJS (pas d'auth requise)"
          },
          "response": []
        },
