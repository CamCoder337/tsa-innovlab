            },
            "url": {
              "raw": "{{base_url}}/product-recommendations/personalized",
              "host": ["{{base_url}}"],
              "path": ["product-recommendations", "personalized"]
            },
            "description": "Recommandations pour un nouvel utilisateur (devrait utiliser popularity_based)"
