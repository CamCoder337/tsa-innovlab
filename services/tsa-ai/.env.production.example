# ========================================
# TSA AI - PRODUCTION ENVIRONMENT
# ========================================
# Configuration pour déploiement en production
# Copier ce fichier et remplir avec les vraies valeurs

# ========================================
# APPLICATION
# ========================================
APP_NAME="TSA Contest AI API"
APP_VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false
LOG_LEVEL="INFO"

# ========================================
# BASE DE DONNÉES POSTGRESQL
# ========================================
DATABASE_URL=postgresql://user:password@postgres:5432/tsa_contest

# ========================================
# REDIS CACHE
# ========================================
REDIS_URL=redis://:password@redis:6379/1
CACHE_TTL_SECONDS=300

# ========================================
# CORS ORIGINS
# ========================================
ALLOWED_ORIGINS='["https://votre-domaine.com"]'

# ========================================
# ML MODELS
# ========================================
MODELS_PATH="ml_models"
PREDICTION_BATCH_SIZE=100
MODEL_RELOAD_INTERVAL=3600

# ========================================
# GOOGLE CLOUD VISION API
# ========================================
# OPTION 1 (RECOMMANDÉ): Contenu JSON complet en variable d'environnement
# Copier tout le contenu de votre google-credentials.json ici (sur une seule ligne)
GOOGLE_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'

# OPTION 2: Chemin vers le fichier (si monté en volume Docker)
# GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/google-credentials.json

# ========================================
# MONITORING (Optionnel)
# ========================================
SENTRY_DSN=""

# ========================================
# INTERNAL SERVICE COMMUNICATION
# ========================================
INTERNAL_SERVICE_SECRET="changez-ce-secret-en-production"

# ========================================
# LLM CONFIGURATION (Groq)
# ========================================
# Get your free API key at: https://console.groq.com
# Free tier: 14,400 requests/day
GROQ_API_KEY="your_groq_api_key_here"
LLM_MODEL="llama-3.3-70b-versatile"
LLM_ENABLED=true
