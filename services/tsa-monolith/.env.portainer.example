# ========================================
# TSA MONOLITH - PORTAINER ENVIRONMENT
# ========================================
# Template des variables d'environnement pour déploiement Portainer
# Copier et renseigner dans Portainer > Stacks > Add Stack > Environment Variables

# ========================================
# APPLICATION (OBLIGATOIRE)
# ========================================
# Clé de chiffrement AdonisJS - Générer avec: node ace generate:key
APP_KEY=-upkrBdXc9P19O8oq2bm6PGygS--Toqv

# Niveau de logs: debug, info, warn, error
LOG_LEVEL=info

# ========================================
# BASE DE DONNÉES POSTGRESQL (OBLIGATOIRE)
# ========================================
DB_USER=tsa_admin
DB_PASSWORD=SuperSecretPassword123!
DB_DATABASE=tsa_contest_prod

# ========================================
# REDIS CACHE & QUEUE (OBLIGATOIRE EN PRODUCTION)
# ========================================
# Laisser vide = sans mot de passe (NON RECOMMANDÉ)
REDIS_PASSWORD=RedisSecretPassword456!

# ========================================
# EMAIL SMTP (OBLIGATOIRE)
# ========================================
# Gmail: smtp.gmail.com:587
# SendGrid: smtp.sendgrid.net:587
# Mailgun: smtp.mailgun.org:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@tsa-logistics.com
SMTP_PASSWORD=votre_app_password_gmail

# ========================================
# EMAIL RESEND (OPTIONNEL - Alternative à SMTP)
# ========================================
# Clé API Resend (laisser vide si vous utilisez SMTP)
RESEND_API_KEY=re_votre_cle_resend

# Domaine email Resend (ex: onboarding.votredomaine.com)
MAIL_DOMAIN=onboarding.tsa-logistics.com

# ========================================
# URLS & EMAILS (OBLIGATOIRE)
# ========================================
# URL du frontend en production
FRONTEND_URL=https://app.tsa-logistics.com

# Email expéditeur (doit correspondre au SMTP_USERNAME)
MAIL_FROM=noreply@tsa-logistics.com

# Email de support (optionnel)
SUPPORT_EMAIL=support@tsa-logistics.com

# ========================================
# ADMIN PAR DÉFAUT (OBLIGATOIRE)
# ========================================
# Email de l'utilisateur admin créé automatiquement au démarrage
ADMIN_EMAIL=admin@tsa-logistics.com

# Mot de passe de l'admin par défaut (à changer après première connexion)
ADMIN_PASSWORD=Admin123!

# ========================================
# PORTS (OPTIONNEL)
# ========================================
# Port exposé sur l'hôte pour le backend (défaut: 30000)
# Ce port doit être ouvert dans le firewall de votre VPS
# Exemple: ufw allow 30000/tcp (si UFW est utilisé)
BACKEND_PORT=30000

# ========================================
# INSTRUCTIONS PORTAINER (DÉPLOIEMENT DEPUIS GITHUB)
# ========================================
# 1. Commiter stack.env, docker-compose.portainer.yml et nginx-backend.conf sur GitHub
# 2. Aller dans Portainer > Stacks > Add Stack
# 3. Nommer la stack: tsa-backend-prod
# 4. Build method: Repository
# 5. Repository URL: https://github.com/votre-org/tsa-innovlab
# 6. Repository reference: refs/heads/main
# 7. Compose path: services/tsa-monolith/docker-compose.portainer.yml
# 8. Section "Environment variables" > Cliquer "Advanced mode"
# 9. Copier-coller TOUTES les variables ci-dessous (sans les commentaires #)
# 10. Modifier les valeurs selon votre environnement
# 11. Cliquer "Deploy the stack"
#
# IMPORTANT:
# - Ne PAS inclure les lignes de commentaires (#) dans Portainer
# - Vérifier que le réseau InnovLabG1 existe déjà dans Portainer
# - Le fichier stack.env contient des placeholders que Portainer remplacera
# - Portainer va builder l'image Docker automatiquement depuis le Dockerfile

# ========================================
# EXEMPLE POUR PORTAINER (SANS COMMENTAIRES)
# ========================================
# APP_KEY=-upkrBdXc9P19O8oq2bm6PGygS--Toqv
# LOG_LEVEL=info
# DB_USER=tsa_admin
# DB_PASSWORD=SuperSecretPassword123!
# DB_DATABASE=tsa_contest_prod
# REDIS_PASSWORD=RedisSecretPassword456!
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=noreply@tsa-logistics.com
# SMTP_PASSWORD=votre_app_password_gmail
# RESEND_API_KEY=re_votre_cle_resend
# MAIL_DOMAIN=onboarding.tsa-logistics.com
# FRONTEND_URL=https://app.tsa-logistics.com
# MAIL_FROM=noreply@tsa-logistics.com
# SUPPORT_EMAIL=support@tsa-logistics.com
# ADMIN_EMAIL=admin@tsa-logistics.com
# ADMIN_PASSWORD=Admin123!
# BACKEND_PORT=3333
