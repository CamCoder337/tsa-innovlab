{
  "extends": "@adonisjs/tsconfig/tsconfig.app.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./build",
    "baseUrl": ".",
    "skipLibCheck": true,
    "paths": {
      "#enums/*": [
        "app/enums/*"
      ],
      "#models/*": [
        "app/models/*"
      ],
      "#validators/*": [
        "app/validators/*"
      ],
      "#services/*": [
        "app/services/*"
      ],
      "#types/*": [
        "types/*"
      ]
    }
  },
  "include": [
    "./app/**/*.ts",
    "./bin/**/*.ts",
    "./commands/**/*.ts",
    "./config/**/*.ts",
    "./start/**/*.ts",
    "./tests/**/*.ts",
    "./types/**/*.ts",
    "./types/extended.d.ts",
    "./adonisrc.ts"
  ],
  "exclude": [
    "node_modules",
    "build"
  ]
}