# ========================================
# TSA MONOLITH - STACK ENVIRONMENT
# ========================================
# Ce fichier est utilisé par Portainer lors du déploiement depuis GitHub
# Les valeurs ci-dessous sont des PLACEHOLDERS
# Les vraies valeurs doivent être renseignées dans Portainer > Environment variables

# ========================================
# APPLICATION
# ========================================
APP_KEY=${APP_KEY}
LOG_LEVEL=${LOG_LEVEL:-info}

# ========================================
# BASE DE DONNÉES POSTGRESQL
# ========================================
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
DB_DATABASE=${DB_DATABASE}

# ========================================
# REDIS CACHE & QUEUE
# ========================================
REDIS_PASSWORD=${REDIS_PASSWORD}

# ========================================
# EMAIL SMTP
# ========================================
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT}
SMTP_USERNAME=${SMTP_USERNAME}
SMTP_PASSWORD=${SMTP_PASSWORD}

# ========================================
# URLS & EMAILS
# ========================================
FRONTEND_URL=${FRONTEND_URL}
MAIL_FROM=${MAIL_FROM}
SUPPORT_EMAIL=${SUPPORT_EMAIL}

# ========================================
# PORTS
# ========================================
BACKEND_PORT=${BACKEND_PORT:-3333}
