              "    pm.expect(jsonData.data.email).to.eql('admin@tsa-logistics.com');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "🔄 Refresh Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
