    {
      "name": "2. Missions",
      "item": [
        {
          "name": "Create Mission (Affreteur)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('mission_id', response.data.mission.id);",
                  "    console.log('✅ Mission ID saved:', response.data.mission.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{affreteur_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"Transport Douala → Yaoundé\",\n  \"description\": \"Livraison de matériel électronique urgent\",\n  \"typeMarchandise\": \"Électronique\",\n  \"poids\": 150,\n  \"volume\": 2.5,\n  \"budgetMin\": 50000,\n  \"budgetMax\": 75000,\n  \"dateDepartEstime\": \"2025-01-15T08:00:00Z\",\n  \"dateArriveeEstime\": \"2025-01-15T12:00:00Z\",\n  \"adresseDepart\": {\n    \"street\": \"Boulevard de la Liberté\",\n    \"city\": \"Douala\",\n    \"postalCode\": \"1234\",\n    \"country\": \"Cameroun\",\n    \"latitude\": 4.0511,\n    \"longitude\": 9.7679\n  },\n  \"adresseArrivee\": {\n    \"street\": \"Avenue Kennedy\",\n    \"city\": \"Yaoundé\",\n    \"postalCode\": \"5678\",\n    \"country\": \"Cameroun\",\n    \"latitude\": 3.8480,\n    \"longitude\": 11.5021\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/affreteur/missions",
              "host": ["{{base_url}}"],
              "path": ["api", "affreteur", "missions"]
            }
          }
        },
        {
          "name": "Publish Mission (WebSocket Test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{affreteur_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/affreteur/missions/{{mission_id}}/publish",
              "host": ["{{base_url}}"],
              "path": ["api", "affreteur", "missions", "{{mission_id}}", "publish"]
            },
            "description": "⚠️ AVANT D'EXÉCUTER : Connectez vos WebSockets transporteurs !\n\n✅ Résultat attendu : Les 2 transporteurs connectés reçoivent une notification en temps réel"
          }
        },
