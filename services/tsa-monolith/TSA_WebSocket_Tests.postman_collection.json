            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Bonjour ! Je suis intéressé par la mission Douala → Yaoundé. Pouvez-vous me donner plus de détails ?\",\n  \"type\": \"text\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/common/conversations/{{conversation_id}}/messages",
              "host": ["{{base_url}}"],
              "path": ["api", "common", "conversations", "{{conversation_id}}", "messages"]
            },
            "description": "⚠️ AVANT D'EXÉCUTER : Connectez le WebSocket de l'affreteur !\n\n✅ Résultat attendu : L'affreteur reçoit le message en temps réel"
          }
        },
