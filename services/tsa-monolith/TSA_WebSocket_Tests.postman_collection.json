    {
      "name": "3. Chat & Messages",
      "item": [
        {
          "name": "Create Direct Conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('conversation_id', response.data.id);",
                  "    console.log('✅ Conversation ID saved:', response.data.id);",
