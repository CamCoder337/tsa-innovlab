          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{transporteur1_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{affreteur_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/common/conversations/direct",
              "host": ["{{base_url}}"],
              "path": ["api", "common", "conversations", "direct"]
            }
          }
        },
        {
          "name": "Send Message (WebSocket Test)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{transporteur1_token}}"
