TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=your_32_character_app_key_here_
NODE_ENV=development

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_DATABASE=tsa_logistics

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Mail Configuration
# Gmail SMTP (pour développement local)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=noreply@tsa-logistics.com

# Resend API (pour production)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_DOMAIN=onboarding.cam-coder.com

# Application URLs
FRONTEND_URL=http://localhost:5173
FRONTEND_PRODUCTION_URL=https://tsa-logistics.com
SUPPORT_EMAIL=support@tsa-logistics.com

#Admin configuration (put a valid and functionnal email adress)
ADMIN_EMAIL=your-email
ADMIN_PASSWORD=your-password
