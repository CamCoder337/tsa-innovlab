TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=your_32_character_app_key_here_
NODE_ENV=development

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_DATABASE=tsa_logistics

